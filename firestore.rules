rules_version = '2';

// ---------------------------------------------------------------------
// This game runs entirely in the browser — there are no Cloud Functions,
// which is what keeps it on Firebase's free plan. That means clients do
// the writing, so these rules can't enforce game logic the way a server
// would. Correctness is protected instead by Firestore transactions with
// idempotency guards (see src/lib/engine.ts).
//
// What these rules DO still enforce, because it costs nothing:
//   · only signed-in players who are in a room can touch it at all
//   · a team's four keywords are unreadable to the other team
//   · the final reveal stays sealed until the game is actually over
//
// What they DON'T stop: a player who opens devtools during a round can
// read the opposing team's code for that round. This is a deliberate
// trade — see the "Trust model" section of the README.
// ---------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function roomData(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId)).data;
    }

    function inRoom(roomId) {
      return signedIn() && request.auth.uid in roomData(roomId).players;
    }

    match /rooms/{roomId} {
      // createRoom does tx.get on a missing doc (resource == null). joinRoom
      // reads a lobby before the joiner is in players. Mid-game, only members.
      allow get: if signedIn() && (
                   resource == null
                   || request.auth.uid in resource.data.players
                   || resource.data.phase == 'lobby'
                 );
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.hostUid == request.auth.uid
                    && request.auth.uid in request.resource.data.players;
      allow update: if signedIn()
                    && (request.auth.uid in resource.data.players
                        || request.auth.uid in request.resource.data.players);
      allow delete: if signedIn() && request.auth.uid in resource.data.players;
    }

    // The four keywords. Still sealed from the opposing team — this is
    // the secret that lasts the whole game, so it's worth keeping.
    match /rooms/{roomId}/private/{teamId} {
      // Missing doc: any room member may listen (startGame race). Existing
      // doc: team members only — except the host during the keys glance,
      // so they can preview and reshuffle both sides.
      allow read: if signedIn() && (
                    resource == null
                      ? inRoom(roomId)
                      : (
                          request.auth.uid in resource.data.members
                          || (inRoom(roomId)
                              && roomData(roomId).hostUid == request.auth.uid
                              && roomData(roomId).phase == 'keys')
                        )
                  );
      allow create: if inRoom(roomId);
      allow update: if signedIn() && (
                      request.auth.uid in resource.data.members
                      || (inRoom(roomId)
                          && roomData(roomId).hostUid == request.auth.uid
                          && roomData(roomId).phase == 'keys')
                    );
      allow delete: if inRoom(roomId);
    }

    // Per-round codes and the deck. Readable by anyone in the room,
    // because whoever scores the round has to compare both codes and
    // there is no server to do it for them.
    match /rooms/{roomId}/secret/{docId} {
      allow read, write: if inRoom(roomId);
    }

    // The shared live draft: numbers everyone on the team can move, and
    // whoever taps send, sends.
    match /rooms/{roomId}/drafts/{docId} {
      allow read, write: if inRoom(roomId);
    }

    // Each player's running theory about the opponent's four words.
    // Stays inside the team.
    match /rooms/{roomId}/guesses/{docId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if inRoom(roomId);
      allow update: if signedIn() && request.auth.uid == resource.data.uid;
      allow delete: if inRoom(roomId);
    }

    // Finished rounds — public to the table by the time they exist.
    match /rooms/{roomId}/rounds/{roundId} {
      allow read, write: if inRoom(roomId);
    }

    // "Who wandered off" — everyone sees it, that's the point.
    match /rooms/{roomId}/away/{docId} {
      allow read: if inRoom(roomId);
      // create/update: only your own row. delete: any member (host wipe
      // on return-to-lobby must clear everyone's away docs).
      allow create, update: if inRoom(roomId)
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if inRoom(roomId);
    }

    // All eight keywords, written at deal time and unreadable until the
    // game actually ends. This is what makes the final screen a reveal
    // rather than a formality.
    match /rooms/{roomId}/final/{docId} {
      allow read: if inRoom(roomId) && roomData(roomId).phase == 'over';
      allow write: if inRoom(roomId);
    }
  }
}
